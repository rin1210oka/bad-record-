{
  "name": "shuttle-note",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite --config vite.firebase.config.ts",
    "build": "vite build --config vite.firebase.config.ts",
    "start": "vite preview --config vite.firebase.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:domain && npm run test:firebase",
    "test:domain": "node --test tests/domain.test.mjs",
    "test:firebase": "firebase emulators:exec --only firestore --project demo-shuttle-note \"node --test --test-concurrency=1 tests/firebase/*.test.mjs\"",
    "deploy": "npm run build && firebase deploy --only firestore:rules,firestore:indexes,hosting"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "firebase-tools": "15.34.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module",
  "overrides": {
    "@grpc/grpc-js": "1.13.6",
    "source-map-js": "1.2.2",
    "fast-uri": "3.1.9"
  }
}
